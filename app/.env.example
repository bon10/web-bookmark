# --- Supabase ---
# ブラウザからも参照するため NEXT_PUBLIC_ を付ける。
# publishable key は公開前提のキーで、アクセス制御は Supabase 側の RLS が行う。
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# supabase CLI がリモートDBに接続するときに使う。アプリからは参照しない。
DB_PASSWORD=xxx

# --- Cloudflare R2（サムネイル保存先）---
# サーバー側でのみ使う。NEXT_PUBLIC_ を付けないこと（付けるとブラウザに配信される）。
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=xxx

# バケットのパブリックアクセスを有効にすると発行される配信元URL。
# 画像URLの組み立てにのみ使い、認証情報を含まないためブラウザに出てよい。
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxx.r2.dev
